    {
      "parameters": {
        "jsCode": "// ============================================================\n// BUILD PROMPT NODE — customize before your first run\n// ============================================================\n// This node appends a \"style block\" to each row's scene_prompt.\n// The style block is what keeps every image in your series looking\n// like it belongs to the same brand. EDIT THE TWO BLOCKS BELOW:\n//\n//   1. Replace the [BRACKETED] placeholders with your own choices.\n//   2. Pick 3-4 brand colors and use them in BOTH lanes (hex codes\n//      work well in the illustration lane; in the photo lane,\n//      describe them as color-grading/wardrobe tones instead).\n//   3. Keep the \"no text, no logos\" rules — image models render\n//      text badly, and stray logos create rights problems.\n//   4. Keep the aspect-ratio phrase matched to the size you request\n//      in the HTTP node (1536x1024 = 16:9-ish landscape).\n//\n// Consistency comes from palette, light, and mood — not from\n// forcing one style onto every image. That's why there are two\n// lanes: PHOTO for human stories, ILLUSTRATION for concepts.\n// ============================================================\n\nconst LANE_PHOTO =\n  \"Warm editorial lifestyle photograph, natural light, shallow depth \" +\n  \"of field, [YOUR TYPICAL SETTING, e.g. domestic / office / outdoor], \" +\n  \"calm and uncluttered, candid and genuine, color grading toward \" +\n  \"[COLOR 1], [COLOR 2], [COLOR 3] and [COLOR 4] tones carried in \" +\n  \"wardrobe and set, no visible brand logos, no readable text anywhere \" +\n  \"in frame. 16:9 landscape.\";\n\nconst LANE_ILLUSTRATION =\n  \"Warm textured illustration with a hand-painted gouache feel, soft \" +\n  \"natural light and gentle shadows, subtle paper grain, limited \" +\n  \"palette of [COLOR 1 #HEX], [COLOR 2 #HEX], [COLOR 3 #HEX] and \" +\n  \"[COLOR 4 #HEX], [YOUR MOOD, e.g. cozy detail, friendly but not \" +\n  \"childish], generous negative space. No text, no letters, no \" +\n  \"numbers, no logos. 16:9 landscape composition.\";\n\n// ------------------------------------------------------------\n// No edits needed below this line.\n// The `lane` column accepts: photo, p, illustration, or i\n// (case-insensitive). Anything else defaults to photo.\n// ------------------------------------------------------------\n\nfor (const item of $input.all()) {\n  const lane = String(item.json.lane || 'photo').trim().toLowerCase();\n  const scene = String(item.json.scene_prompt || '').trim();\n  const isIllustration = lane === 'i' || lane === 'illustration';\n  const block = isIllustration ? LANE_ILLUSTRATION : LANE_PHOTO;\n  item.json.full_prompt = scene + ' ' + block;\n  if (!item.json.filename) {\n    item.json.filename = String(item.json.slug || 'unnamed') + '-hero.png';\n  }\n}\nreturn $input.all();"
      },
      "id": "fea512e8-4a48-4997-ac46-6d5afb66a65b",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
